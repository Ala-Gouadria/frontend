VITE_API_BASE_URL=http://localhost:3000

# Auth0 (Universal Login — primary auth path). Leave domain/client_id empty to disable
# Auth0 and fall back to the local email/password form.
VITE_AUTH0_DOMAIN=auth.xworldltd.com
VITE_AUTH0_CLIENT_ID=ggkgp4wnPryWiF3Pqu2tYhLYrIxzYvhf
# Optional: the NORA API identifier registered in Auth0 (enables aud-scoped access tokens).
VITE_AUTH0_AUDIENCE=

# Voice mode toggle.
# "demo"  → scripted MP3s play instantly for known prompts (no API cost, works offline).
# "live"  → every prompt goes through the real chat + OpenAI TTS pipeline.
# Switch by changing this value — no code changes needed.
VITE_VOICE_MODE=demo
